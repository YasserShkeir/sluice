# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Local runtime data — NEVER commit captured traffic or secrets
.sluice/
*.sqlite
*.sqlite-journal
*.sqlite-wal
captures/
*.har
*.pcap
exports/
*.ndjson
*.jsonl
# ...except adapter fixtures, which are scrubbed synthetic captures by design.
# The project graph drops tracked files an ignore rule matches, so this
# re-include is what keeps packages/app-*/fixtures/*.ndjson indexed.
!**/fixtures/**/*.ndjson
!**/fixtures/**/*.jsonl

# Secrets / credentials (belt-and-suspenders — the tool keeps these in memory only)
*.pem
*.key
.env
.env.*
!.env.example
.envrc
.netrc
.git-credentials
.yarnrc.yml
.docker/config.json
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
!id_*.pub
*.p8
*.jks
*.keystore
*.gpg
*.asc
*.tfstate
*.tfstate.*

# Local CA material
ca/
*.crt

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
CLAUDE.local.md

# Design docs, plans and captured API catalogs — kept locally, not in the repo.
# The API catalogs in particular are rendered from real captured traffic.
# Note the trailing /* rather than /: git will not descend into an excluded
# DIRECTORY, so `docs/` would make the re-include below impossible.
docs/*
# ...except docs/public/, which is where anything meant for readers goes. The
# carve-out is deliberate: a trust artifact nobody can read does no work, while
# everything else under docs/ either contains real captured traffic or is a
# private working note.
!docs/public/

# Claude Code per-user permissions (can hold local paths/commands)
.claude/settings.local.json
