{
  "name": "@sluice/runner",
  "version": "0.0.0",
  "type": "module",
  "description": "Sluice — local-only interceptor + explorer for your own SaaS API traffic (CLI + loopback server).",
  "bin": {
    "sluice": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chrome-remote-interface": "^0.34.0",
    "classic-level": "^1.4.0",
    "mockttp": "^4.6.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@sluice/apps": "workspace:*",
    "@sluice/cartographer": "workspace:*",
    "@sluice/core": "workspace:*",
    "@sluice/protocol": "workspace:*",
    "@sluice/interceptor": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.13",
    "@sluice/adapter-sdk": "workspace:*",
    "@sluice/mcp": "workspace:*"
  },
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
