{
  "name": "@sluice/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Sluice core: normalized types, capture schema, WS protocol, and the SQLite store.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
